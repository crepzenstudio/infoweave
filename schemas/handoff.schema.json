{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://infoweave.example/schemas/handoff.schema.json",
  "title": "InfoWeave Handoff Document Frontmatter",
  "description": "Frontmatter schema for handoffs/*.md relay records.",
  "type": "object",
  "required": ["id", "type", "from_env", "to_env", "agent_id", "status", "last_updated"],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^handoff-[a-z0-9-]+$",
      "description": "kebab-case, e.g. handoff-2026-05-30-1035-site-a-topic"
    },
    "type": { "type": "string", "const": "handoff" },
    "from_env": {
      "type": "string",
      "description": "Originating machine/location label (a <site>)"
    },
    "to_env": {
      "type": "string",
      "description": "Target machine/location label, or 'any'"
    },
    "agent_id": {
      "type": "string",
      "description": "Authoring agent identifier (runtime + session/timestamp)"
    },
    "status": {
      "type": "string",
      "enum": ["open", "consumed", "superseded"]
    },
    "last_updated": {
      "type": "string",
      "description": "ISO 8601 datetime with offset, e.g. 2026-05-30T10:35:00+00:00"
    },
    "related_handoffs": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true,
      "description": "ids or filenames of related handoffs"
    },
    "superseded_by": {
      "type": "string",
      "description": "Set when status=superseded; id/filename of the replacement"
    },
    "cross_env": {
      "type": "boolean",
      "description": "True if this handoff crosses machine/network boundaries"
    },
    "mode": {
      "type": "string",
      "enum": ["solo", "with-user", "review-only"],
      "description": "Working mode that produced this handoff"
    }
  }
}
